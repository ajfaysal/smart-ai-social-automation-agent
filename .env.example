# Required
OPENAI_API_KEY=

# Optional model overrides
DUBBING_STT_MODEL=whisper-1
DUBBING_DIRECTOR_MODEL=gpt-4o-mini
DUBBING_TRANSLATION_MODEL=gpt-4o-mini
DUBBING_TTS_MODEL=gpt-4o-mini-tts

# Background preservation: Demucs must be installed when preserve_background=true.
# Lip-sync is disabled unless explicitly configured.
LIPSYNC_PROVIDER=disabled
WAV2LIP_COMMAND=
WAV2LIP_MODEL_PATH=

# Face / mouth eligibility
FACE_DETECTOR=disabled
MOUTH_LANDMARK_PROVIDER=disabled
# LANDMARK_PROVIDER is accepted as a compatibility fallback.

# Optional provider examples:
# FACE_DETECTOR=opencv
# MOUTH_LANDMARK_PROVIDER=mediapipe
# LIPSYNC_PROVIDER=wav2lip
